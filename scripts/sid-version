#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

records="$(apt-cache showsrc --only-source git)"
versions="$(sed --quiet 's/^Version: //p' <<< "$records" | sort --unique)"

if [ -z "$versions" ]; then
    printf 'no git source version found in Debian unstable\n' >&2
    exit 1
fi

if [[ "$versions" == *$'\n'* ]]; then
    printf 'expected one git source version in Debian unstable, found:\n%s\n' "$versions" >&2
    exit 1
fi

printf '%s\n' "$versions"
