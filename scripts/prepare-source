#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

sid_version="$1"
upstream="$2"
rebuild_version="$3"
workdir="$(realpath --canonicalize-missing "$4")"
self="$(realpath "$0")"
scripts="$(dirname "$self")"
sid_without_epoch="${sid_version#*:}"
sid_upstream="${sid_without_epoch%-*}"
build_dependencies="$(mktemp --directory)"

mkdir --parents "$workdir"
cd "$workdir"
apt-get source --only-source "git=${sid_version}"
tree="${workdir}/git-${upstream}"
changelog_entry="Rebuild of the Debian unstable source package for Debian trixie."

if [ "$upstream" != "$sid_upstream" ]; then
    "${scripts}/fetch-upstream-tarball" "$upstream" "$workdir"
    tar --extract --file "${workdir}/git_${upstream}.orig.tar.xz" --directory "$workdir"
    cp --recursive "${workdir}/git-${sid_upstream}/debian" "${tree}/debian"
    changelog_entry="New upstream release ${upstream} from kernel.org, packaged with the packaging of the Debian unstable git ${sid_version}."
fi

cd "$build_dependencies"
mk-build-deps --install --remove --tool 'apt-get --yes --no-install-recommends' "${tree}/debian/control"

cd "$tree"
dch --newversion "$rebuild_version" --force-bad-version --distribution trixie "$changelog_entry"
changelog_version="$(dpkg-parsechangelog --show-field Version)"

if [ "$changelog_version" != "$rebuild_version" ]; then
    printf 'debian/changelog carries version %s, expected %s\n' "$changelog_version" "$rebuild_version" >&2
    exit 1
fi
